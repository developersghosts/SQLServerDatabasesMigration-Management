@inherits LocalizedComponentBase
@inject IJSRuntime JS

<details class="sql-preview" open="@Open">
    <summary>@L["ShowScript"]</summary>
    <div class="sql-preview-body">
        <button class="btn xs copy-btn" type="button" @onclick="CopyAsync"><Icon Name="copy" /> @L["Copy"]</button>
        <pre dir="ltr">@(string.IsNullOrWhiteSpace(Sql) ? "--" : Sql)</pre>
    </div>
</details>

@code {
    [Parameter] public string? Sql { get; set; }
    [Parameter] public bool Open { get; set; }

    private async Task CopyAsync() => await JS.InvokeAsync<bool>("sqlManager.copyText", Sql ?? string.Empty);
}
